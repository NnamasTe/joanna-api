datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Obra{
  id            Int      @id @default(autoincrement())
  titulo        String
  preco         Float
  fotoUrl       String
  legenda       String?
  anoCriacao    String
  dimensoes     String

  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt
}